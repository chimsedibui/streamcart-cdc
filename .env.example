# Non-secret settings. Secrets are files in secrets/ (gitignored), created by ./setup-env.sh, which also writes this
# file as .env.

# Authorization in the Source API: off, permissive (count would-be denials) or enforce
AUTH_MODE=enforce

# Simulator: catalog size preset (small | medium | large) and business clock speed (× wall clock)
SIM_SCALE=small
SIM_SPEED=240

# Optional parts of the platform (docker compose profiles): platform (Trino, Dagster), monitoring (Prometheus,
# Grafana), lineage (Marquez), bi (Superset). Together with the base stack all four need about 16 GB of RAM.
COMPOSE_PROFILES=platform,monitoring
